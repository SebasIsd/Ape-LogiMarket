From a8a99ebe3f87f63e34f43a7d0f5e4496bdec77f1 Mon Sep 17 00:00:00 2001
From: revision <r@example.com>
Date: Tue, 24 Nov 2026 00:55:04 +0000
Subject: [PATCH] fix: asignar PedidoId en detalles al guardar y mostrar inner
 exception al validar

---
 .../Persistence/Repositories/RepositorioPedido.cs         | 8 +++++++-
 LogiMarket.WinForms/Forms/FrmCarrito.cs                   | 5 ++++-
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/LogiMarket.Infrastructure/Persistence/Repositories/RepositorioPedido.cs b/LogiMarket.Infrastructure/Persistence/Repositories/RepositorioPedido.cs
index ee8631c..15010e8 100644
--- a/LogiMarket.Infrastructure/Persistence/Repositories/RepositorioPedido.cs
+++ b/LogiMarket.Infrastructure/Persistence/Repositories/RepositorioPedido.cs
@@ -98,6 +98,8 @@ public class RepositorioPedido : IRepositorioPedido
         foreach (var d in pedido.Detalles)
         {
             _db.PedidoDetalles.Add(d);
+            // PedidoDetalle no tiene navegación hacia Pedido: la FK se asigna explícitamente
+            _db.Entry(d).Property(x => x.PedidoId).CurrentValue = pedido.Id;
         }
 
         await _db.SaveChangesAsync(ct);
@@ -109,7 +111,11 @@ public class RepositorioPedido : IRepositorioPedido
         // Sincronizar detalles
         var existentes = await _db.PedidoDetalles.Where(d => d.PedidoId == pedido.Id).ToListAsync(ct);
         _db.PedidoDetalles.RemoveRange(existentes);
-        foreach (var d in pedido.Detalles) _db.PedidoDetalles.Add(d);
+        foreach (var d in pedido.Detalles)
+        {
+            _db.PedidoDetalles.Add(d);
+            _db.Entry(d).Property(x => x.PedidoId).CurrentValue = pedido.Id;
+        }
         await _db.SaveChangesAsync(ct);
     }
 
diff --git a/LogiMarket.WinForms/Forms/FrmCarrito.cs b/LogiMarket.WinForms/Forms/FrmCarrito.cs
index 3f4636d..f7d72fd 100644
--- a/LogiMarket.WinForms/Forms/FrmCarrito.cs
+++ b/LogiMarket.WinForms/Forms/FrmCarrito.cs
@@ -567,7 +567,10 @@ public class FrmCarrito : UserControl, IViewRefrescable
         }
         catch (Exception ex)
         {
-            MessageBox.Show($"Error de validación: {ex.Message}", "Rechazo",
+            // Mostrar la causa real (EF Core oculta el detalle en InnerException)
+            var causa = ex;
+            while (causa.InnerException is not null) causa = causa.InnerException;
+            MessageBox.Show($"Error de validación: {causa.Message}", "Rechazo",
                 MessageBoxButtons.OK, MessageBoxIcon.Error);
         }
     }
-- 
